# Copy this file to `.env` to configure the prototype.
# Everything works WITHOUT this file (mock mode).

# Optional: add ONE of these to switch AI calls from mock to real.
# (OPENAI_API_KEY also enables real embeddings for claim matching.)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: Voyage AI key — real embeddings for claim matching when you don't
# have an OpenAI key (docs/integrations/llm.md, "Embeddings" section).
# VOYAGE_API_KEY=pa-...

# Optional: TikTok Research API credentials (docs/integrations/tiktok.md).
# Setting BOTH switches fetch_tiktok() from mock data to the real API.
# TIKTOK_CLIENT_KEY=aw...
# TIKTOK_CLIENT_SECRET=...

# Optional: Google Fact Check Tools API key (free) — switches the fact-check
# sync from the mock corpus to real published fact-checks.
# How to get one: docs/integrations/factcheck.md
# FACTCHECK_API_KEY=AIza...

# --- Database backend --------------------------------------------------------
# Default is SQLite (zero setup, file at data/prototype.db). Set BOTH of these
# to run on Postgres instead — any Postgres works; Supabase is hosted Postgres,
# so paste the connection string from their dashboard as DATABASE_URL.
# DB_BACKEND=postgres
# DATABASE_URL=postgres://postgres:dev@localhost:54329/democracy

# --- Background worker (app/worker.py) ---------------------------------------
# All optional. `python run.py` sets RUN_WORKER=1 by default; tests leave it
# unset so the worker thread never runs there.

# 1 = start the background worker thread that drains the job queue.
# RUN_WORKER=1

# Seconds between worker poll cycles.
# WORKER_POLL_SECONDS=2

# Every N minutes the worker re-ingests all sources (mock-safe; it only
# ingests + enriches — nothing is ever posted). 0 = disabled.
# SCHEDULE_INGEST_MINUTES=0

# Secret key for pseudonymizing author IDs (HMAC). Any long random string.
# The default below is fine for the prototype; change it for anything real.
PSEUDONYM_KEY=prototype-dev-key-change-me

# --- Tunable thresholds (app/config.py) --------------------------------------
# All optional. Defaults shown; uncomment and change to override — no code edit
# needed. Active values are shown in the UI footer.

# Reach floor: content below this many views is NEVER surfaced (amplification risk).
# AMPLIFICATION_FLOOR_VIEWS=5000

# Minimum score for an item to become an opportunity.
# SCORE_THRESHOLD=40.0

# Hours until an open opportunity expires.
# OPPORTUNITY_EXPIRY_HOURS=72

# Minimum % of the AI seed a human must change (word-level edit distance).
# EDIT_GATE_MIN_PCT=15.0

# Minimum seconds of review time before a draft can pass the dwell gate.
# DWELL_MIN_SECONDS=60

# Maximum replies a member may post per day.
# RATE_CAP_PER_DAY=5

# Jaccard similarity (0..1) at/above which a reply counts as copypasta.
# COPYPASTA_JACCARD_THRESHOLD=0.85
