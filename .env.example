# Copy this file to `.env` to configure the prototype.
# Everything works WITHOUT this file (mock mode).

# Optional: add ONE of these to switch AI calls from mock to real.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: TikTok Research API credentials (docs/integrations/tiktok.md).
# Setting BOTH switches fetch_tiktok() from mock data to the real API.
# TIKTOK_CLIENT_KEY=aw...
# TIKTOK_CLIENT_SECRET=...

# Secret key for pseudonymizing author IDs (HMAC). Any long random string.
# The default below is fine for the prototype; change it for anything real.
PSEUDONYM_KEY=prototype-dev-key-change-me
